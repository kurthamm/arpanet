	TITLE NETLIT
; NETSER-lite 1b-full (DOICP-lite): the smallest real ICP server.
; Listen on socket 1 (the ICP contact socket); on RFCR, MTOPR-accept (RFCR->OPND),
; then do the ICP socket-swap exactly like NETSER DOICP:
;   - build NET:<lclskt>.<fhost>-<fskt+2>;T (ALL NUMBERS OCTAL -- NAMDEC/EXTDEC parse octal)
;   - GTJFN send + recv data JFNs
;   - BOUT the local data-socket number over the contact connection
;   - CLOSF the contact JFN
;   - OPENF send (103000,,100000) + recv (100000,,200000) data connections
;   - SOUT a test herald on the send JFN
;   - close cleanly.
; No login/PTY/EXEC/herald-ceremony.  Primitive FAIL only.

	OPDEF GTJFN [104B8+20]
	OPDEF RLJFN [104B8+23]
	OPDEF OPENF [104B8+21]
	OPDEF CLOSF [104B8+22]
	OPDEF PSOUT [104B8+76]
	OPDEF NOUT  [104B8+224]
	OPDEF SOUT  [104B8+53]
	OPDEF MTOPR [104B8+77]
	OPDEF GDSTS [104B8+145]
	OPDEF BOUT  [104B8+51]
	OPDEF CVSKT [104B8+275]
	OPDEF DISMS [104B8+167]
	OPDEF HALTF [104B8+170]

	P__17
	A__1
	B__2
	C__3
	D__4
	LCLSK0__100		; chosen local data socket (octal, even)

START:	MOVE P,[IOWD PDLEN,PDLST]
	HRROI A,MSG1
	PSOUT
	HRROI A,CRLF
	PSOUT
; ---- listen on socket 1 ----
	MOVSI A,400001
	HRROI B,FNAME
	GTJFN
	 JRST GJERR
	MOVEM A,SOCKJ
	MOVE B,[XWD 400000,100000]
	OPENF
	 JRST OPERR
	MOVE A,SOCKJ
	MOVEI B,24
	MOVSI C,777723
	MTOPR
	 JFCL
	HRROI A,MSG3
	PSOUT
	HRROI A,CRLF
	PSOUT
; ---- wait for RFC (foreign host appears in GDSTS) ----
WATCH:	MOVE A,SOCKJ
	GDSTS
	MOVEM C,FHST
	MOVEM D,FSKT
	MOVE 5,FHST
	CAIN 5,777
	 JRST WSLP
	JUMPN 5,DOICP
WSLP:	MOVEI A,2000
	DISMS
	JRST WATCH

; ================= ICP =================
DOICP:	HRROI A,MRF		; RFC RECEIVED
	PSOUT
	HRROI A,CRLF
	PSOUT
; build NET:<LCLSK0>.<FHST>-<FSKT+2>;T  (octal numbers)
	MOVEI 1,STRING
	HRLI 1,(<POINT 7,0>)
	HRROI 2,NETPFX
	SETZ 3,
	SOUT
	MOVEI 2,LCLSK0
	MOVEI 3,10		; octal radix
	NOUT
	 JFCL
	MOVEI 2,"."
	IDPB 2,1
	MOVE 2,FHST
	MOVEI 3,10
	NOUT
	 JFCL
	MOVEI 2,"-"
	IDPB 2,1
	MOVE 2,FSKT
	ADDI 2,2
	MOVEI 3,10
	NOUT
	 JFCL
	HRROI 2,SEMIT
	SETZ 3,
	SOUT
; GTJFN the two data sockets
	MOVSI 1,1
	HRROI 2,STRING
	GTJFN
	 JRST FAILJ
	MOVEM 1,SJFN
	MOVSI 1,1
	HRROI 2,STRING
	GTJFN
	 JRST FAILJ
	MOVEM 1,RJFN
	CVSKT
	 JRST FAILJ
	MOVEM 2,LCLSKT
; accept the contact RFC (RFCR -> OPND)
	MOVE A,SOCKJ
	MOVEI B,20
	MTOPR
	 JFCL
	HRROI A,MRA		; ACCEPTED
	PSOUT
	HRROI A,CRLF
	PSOUT
; let the allocate arrive, then send the data-socket number on the contact
	MOVEI A,3000
	DISMS
	HRROI A,MRS		; SEND SOCKET#
	PSOUT
	HRROI A,CRLF
	PSOUT
	MOVE 1,SOCKJ
	MOVE 2,LCLSKT
	BOUT
	HRROI A,MRSD		; SOCKET# SENT
	PSOUT
	HRROI A,CRLF
	PSOUT
; close the contact connection
	MOVE 1,SOCKJ
	CLOSF
	 JFCL
; open the data connections (these block until the client connects)
	HRROI A,MRO		; OPEN DATA
	PSOUT
	HRROI A,CRLF
	PSOUT
	MOVE 1,SJFN
	MOVE 2,[XWD 103000,100000]
	OPENF
	 JRST FAILS
	MOVE 1,RJFN
	MOVE 2,[XWD 100000,200000]
	OPENF
	 JRST FAILR
	HRROI A,MROD		; DATA OPEN
	PSOUT
	HRROI A,CRLF
	PSOUT
; send the test herald on the send JFN
	MOVE A,SJFN
	HRROI B,TLINE
	SETZ C,
	SOUT
	MOVE 1,SJFN
	MOVEI 2,15
	BOUT
	MOVE 1,SJFN
	MOVEI 2,12
	BOUT
	HRROI A,MRH		; HERALD SENT
	PSOUT
	HRROI A,CRLF
	PSOUT
; close cleanly
	MOVE A,SJFN
	CLOSF
	 JFCL
	MOVE A,RJFN
	CLOSF
	 JFCL
	HRROI A,MRC		; DONE
	PSOUT
	HRROI A,CRLF
	PSOUT
	HALTF
	JRST START

FAILJ:	HRROI A,EFJ
	PSOUT
	HALTF
	JRST START
FAILS:	HRROI A,EFS
	PSOUT
	HALTF
	JRST START
FAILR:	HRROI A,EFR
	PSOUT
	HALTF
	JRST START
GJERR:	HRROI A,EGJ
	PSOUT
	HALTF
	JRST START
OPERR:	HRROI A,EOP
	PSOUT
	HALTF
	JRST START

FNAME:	ASCIZ /NET:1#./
NETPFX:	ASCIZ /NET:/
SEMIT:	ASCIZ /;T/
MSG1:	ASCIZ /NETLIT 1C ICP SERVER LISTEN SOCKET 1/
MSG3:	ASCIZ /LISTENING/
MRF:	ASCIZ /RFC RECEIVED/
MRA:	ASCIZ /CONTACT ACCEPTED/
MRS:	ASCIZ /SEND SOCKET NUMBER/
MRSD:	ASCIZ /SOCKET NUMBER SENT/
MRO:	ASCIZ /OPEN DATA SOCKETS/
MROD:	ASCIZ /DATA SOCKETS OPEN/
MRH:	ASCIZ /HERALD SENT/
MRC:	ASCIZ /DONE/
TLINE:	ASCIZ /BBN-TENEX NETLIT TEST/
EFJ:	ASCIZ /GTJFN DATA FAILED/
EFS:	ASCIZ /OPENF SEND FAILED/
EFR:	ASCIZ /OPENF RECV FAILED/
EGJ:	ASCIZ /GTJFN FAILED/
EOP:	ASCIZ /OPENF FAILED/
CRLF:	BYTE (7) 15,12,0

	PDLEN__40
PDLST:	BLOCK PDLEN
SOCKJ:	0
SJFN:	0
RJFN:	0
FHST:	0
FSKT:	0
LCLSKT:	0
STRING:	BLOCK 24
	END START

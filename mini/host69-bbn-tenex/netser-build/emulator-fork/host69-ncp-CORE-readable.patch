+/*
+ * Authentic 1822-over-UDP host interface (ncp mode).
+ *
+ * These two routines relay the raw 1822 host<->IMP message between the PDP-10
+ * host-facing side (sbuffer/rbuffer) and an H316 IMP simulator's host
+ * interface ("hi") over a UDP datagram socket, using R.Armstrong's framing
+ * (imp_udp.c).  The datagram carries an array of 16-bit words: data[0] is an
+ * out-of-band flags word (PFLG_READY = host/imp ready line, PFLG_FINAL = end
+ * of message); data[1..] are the message words.  Because udp_send/udp_receive
+ * htons() each word, the on-the-wire byte order is exactly the sbuffer byte
+ * order, so packing is a plain big-endian byte<->word pairing.
+ */
+void
+imp_udp_send(struct imp_device *imp, int len)
+{
+    uint16 buf[IMP_UDP_MAXDATA];
+    int    i, nw;
+
+    if (imp->udp_link == IMP_UDP_NOLINK)
+        return;
+    /* A complete 1822 message is assembled per call. */
+    buf[0] = PFLG_FINAL | PFLG_READY;
+    nw = 1;
+    for (i = 0; i < len && nw < IMP_UDP_MAXDATA; i += 2) {
+        uint16 w = (uint16)imp->sbuffer[i] << 8;
+        if (i + 1 < len)
+            w |= imp->sbuffer[i + 1];
+        buf[nw++] = w;
+    }
+    sim_debug(DEBUG_DETAIL, &imp_dev, "IMP ncp send %d bytes (%d words)\n", len, nw);
+    (void)udp_send(&imp_dev, imp->udp_link, buf, (uint16)nw);
+}
+
+void
+imp_udp_packet_in(struct imp_device *imp)
+{
+    uint16 buf[IMP_UDP_MAXDATA];
+    int32  nw;
+    int    i, nb;
+
+    if (imp->udp_link == IMP_UDP_NOLINK)
+        return;
+    {
+        static uint32 gate_cnt = 0;
+        if ((++gate_cnt & 0x3ff) == 0)
+            sim_debug(DEBUG_IRQ, &imp_dev,
+                "IMP ncp gate#%u ILEN=%d STATUS=%06o pending=%d link_up=%d\n",
+                gate_cnt, imp_unit[0].ILEN, (uint32)imp_unit[0].STATUS,
+                imp->pending_nw, imp->imp_link_up);
+    }
+    /* Don't fetch a new message while one is still being delivered. */
+    if (imp_unit[0].ILEN != 0 || (imp_unit[0].STATUS & (IMPIB|IMPID)) != 0)
+        return;
+    /* If a message is HELD (received before the host armed input) and the host
+       has now armed (STRIN), deliver the held message instead of receiving a new
+       one.  A real 1822 IMP holds its host-output message until the host takes
+       it; the H316 IMP only sends its startup NOPs once, so we must not drop them
+       just because the monitor had not armed input yet. */
+    if (imp->pending_nw > 0 && imp->imp_link_up) {
+        nw = imp->pending_nw;
+        for (i = 0; i < nw; i++)
+            buf[i] = imp->pending_buf[i];
+        imp->pending_nw = 0;
+    } else {
+        static uint32 ncp_poll_cnt = 0;
+        nw = udp_receive(&imp_dev, imp->udp_link, buf, IMP_UDP_MAXDATA);
+        if ((++ncp_poll_cnt & 0x3ff) == 0 || nw > 0)
+            sim_debug(DEBUG_IRQ, &imp_dev,
+                "IMP ncp recv poll#%u nw=%d buf0=%o link=%d\n",
+                ncp_poll_cnt, nw, nw > 0 ? buf[0] : 0, imp->udp_link);
+        if (nw <= 0)
+            return;
+    }
+    /* buf[0] = out-of-band flags.  ALWAYS surface the IMP-ready line (a status
+       bit the monitor polls via CONI): without it the monitor never sees the IMP
+       come ready, so it never brings up its interface and the host->IMP handshake
+       deadlocks. */
+    if (buf[0] & PFLG_READY)
+        imp_unit[0].STATUS |= IMPR;
+    else
+        imp_unit[0].STATUS &= ~IMPR;
+    /* Deliver a message body ONLY when the monitor has armed input via IMP_STRIN
+       (imp_link_up = "input armed", set in the CONO IMP_STRIN handler).  Matches
+       real 1822 hardware: the host arms an input buffer (STRIN), the IMP delivers
+       one message, then the host re-arms.  This also keeps IMP_IDONE CLEAR until
+       the monitor is ready -- TENEX's bring-up (137143-137145) bails if input-done
+       is already set, so delivering too early aborts the IMP bring-up.  When not
+       armed, surface the ready line and HOLD the body (don't drop it) so the IMP's
+       one-shot startup NOP survives until the monitor arms input. */
+    if (!imp->imp_link_up) {
+        if (nw > 1) {           /* has a body: hold it for the host */
+            for (i = 0; i < nw; i++)
+                imp->pending_buf[i] = buf[i];
+            imp->pending_nw = nw;
+        }
+        check_interrupts(&imp_unit[0]);
+        return;
+    }
+    imp->imp_link_up = 0;       /* consume the arm; monitor must STRIN again */
+    /* Unpack the message words (after the flags word) into rbuffer bytes. */
+    nb = 0;
+    for (i = 1; i < nw; i++) {
+        imp->rbuffer[nb++] = (buf[i] >> 8) & 0xff;
+        imp->rbuffer[nb++] = buf[i] & 0xff;
+    }
+    sim_debug(DEBUG_DETAIL, &imp_dev, "IMP ncp recv %d words (%d msg bytes) flags=%o\n",
+              nw, nb, buf[0]);
+    if (nb == 0) {              /* ready-status datagram only, no message body */
+        check_interrupts(&imp_unit[0]);
+        return;
+    }
+    imp_unit[0].STATUS |= IMPIB;
+    imp_unit[0].IPOS = 0;

+/* imp_udp.h: 1822 host-interface-over-UDP socket routines for the PDP-10 IMP
+
+   Derived verbatim (framing-compatible) from Robert Armstrong's h316_udp.c,
+   Copyright (c) 2013 Robert Armstrong, bob@jfcl.com.  See imp_udp.c.
+
+   This header exposes the minimal UDP datagram interface used by the rcornwell
+   PDP-10 IMP device (kx10_imp.c) when running in authentic "ncp" mode, talking
+   to an H316 IMP simulator's host-interface (hi) over a UDP port pair.  The
+   on-the-wire datagram format is IDENTICAL to h316_udp.c (magic 'H316',
+   per-link sequence number, count of 16-bit words, then network-order words),
+   so a PDP-10 host built with this module is the matched peer of the H316 `hi`.
+*/
+
+#ifndef IMP_UDP_H_
+#define IMP_UDP_H_
+
+#include "sim_defs.h"
+
+#define IMP_UDP_NOLINK   (-1)        /* "no link" handle (cf. h316 NOLINK)      */
+#define IMP_UDP_MAXDATA  16384       /* longest IMP packet, in 16-bit words     */
+
+/* All lengths/counts below are in 16-bit words, NOT bytes - matching RLA. */
+t_stat udp_create  (DEVICE *dptr, const char *premote, int32 *pln);
+t_stat udp_release (DEVICE *dptr, int32 link);
+t_stat udp_send    (DEVICE *dptr, int32 link, uint16 *pdata, uint16 count);
+int32  udp_receive (DEVICE *dptr, int32 link, uint16 *pdata, uint16 maxbuf);
+
+#endif /* IMP_UDP_H_ */

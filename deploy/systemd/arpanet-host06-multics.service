[Unit]
Description=ARPANET MIT-MULTICS host 6 (DPS8M/MR12.8, FEP-bridged via ncp06)
After=arpanet-noc.service arpanet-fep.service
Requires=arpanet-noc.service

[Service]
Type=oneshot
User=deltaprism
Group=deltaprism
WorkingDirectory=/home/deltaprism/arpanet/mini
RemainAfterExit=yes
# Same verify-or-heal + per-host-lock shape as the ITS host@ template, so host 6
# boots identically to the rest instead of via a special manual path.
ExecStart=/usr/bin/flock /tmp/arpanet-host06.lock /bin/bash -lc '/home/deltaprism/arpanet/mini/host06-multicsctl.sh verify || { /home/deltaprism/arpanet/mini/host06-multicsctl.sh stop || true; /home/deltaprism/arpanet/mini/host06-multicsctl.sh start; }'
ExecStop=/usr/bin/flock /tmp/arpanet-host06.lock /home/deltaprism/arpanet/mini/host06-multicsctl.sh stop
TimeoutStartSec=360
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target

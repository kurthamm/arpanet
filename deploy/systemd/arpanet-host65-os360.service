[Unit]
Description=ARPANET UCLA-CCN OS/360 host 65 (Hercules MVT, FEP-bridged via ncp65)
After=arpanet-noc.service arpanet-fep.service
Requires=arpanet-noc.service

[Service]
Type=oneshot
User=deltaprism
Group=deltaprism
WorkingDirectory=/home/deltaprism/arpanet/mini
RemainAfterExit=yes
# Hercules + MVT + front-door bring-up is slow; give it room. `start` is idempotent.
ExecStart=/usr/bin/flock /tmp/arpanet-host65.lock /home/deltaprism/arpanet/mini/host65-ucla-ccnctl.sh start
ExecStop=/usr/bin/flock /tmp/arpanet-host65.lock /home/deltaprism/arpanet/mini/host65-ucla-ccnctl.sh stop
TimeoutStartSec=900
TimeoutStopSec=120

[Install]
WantedBy=multi-user.target
